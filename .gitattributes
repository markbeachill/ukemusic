# Auto detect text files and perform LF normalization
* text=auto

# 4.78.2: files that aren't text, whatever they look like inside: never changed by git (a PDF can
# look like text and have its line endings changed, which spoils it)
*.pdf binary
*.webp binary
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
*.flac binary
*.mp3 binary
*.wav binary
*.ogg binary
